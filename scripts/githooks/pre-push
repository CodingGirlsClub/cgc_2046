#!/usr/bin/env bash
# push 前本地门禁：backend 格式检查（与 CI backend job 的第一步相同）。
# 目的：漏跑 mix format 的提交在本地就被拦下，不必等远端 CI 返工一轮。
#
# - 直接在仓库根执行 git push 时自动触发；也可手动 `bash .githooks/pre-push` 试用。
# - 只读检查（--check-formatted），不会改动文件；耗时通常 1-3 秒。
# - mix 本身跑不起来（依赖未装等）时不阻塞推送——CI 仍会兜底，但会打印提醒。
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ] || [ ! -f "$REPO_ROOT/backend/mix.exs" ]; then
  exit 0  # 不含 backend 的推送目标无需此检查
fi

echo "[pre-push] backend mix format --check-formatted ..."
if (cd "$REPO_ROOT/backend" && mix format --check-formatted); then
  echo "[pre-push] format ok"
  exit 0
else
  status=$?
  if [ "$status" -eq 1 ]; then
    echo "[pre-push] 格式检查未通过——在 backend/ 执行 'mix format' 后重新暂存再推送。" >&2
    exit 1
  fi
  # 2+ = mix 自身故障（依赖缺失等）：不阻塞，CI 会兜底
  echo "[pre-push] mix 运行异常（exit $status）——跳过本地检查，CI 仍会校验。" >&2
  exit 0
fi
