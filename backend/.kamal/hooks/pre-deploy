#!/bin/sh
# Kamal pre-deploy 钩子：blue-green 切流前在服务器上跑 DB 迁移 + seeds。
# 在 Kamal 运行机本地执行（CI runner）；KAMAL_VERSION + 全部 secrets 已注入 env
# （kamal-2.12 cli/main.rb:35，时序 = build+push 之后、proxy/app boot 之前）。
#
# 为什么在服务器跑：DATABASE_URL 的 host 是 kamal docker 网络内的 postgres，
# 仅服务器可解析；runner 侧 docker run 会 nxdomain。
# secrets 传递：本地 env 打包成 env-file 经 SSH stdin 送远端（不出现在任何
# 命令行/ps 输出），远端 docker --env-file /dev/stdin 消费。
#
# 首次部署前置：PG accessory 须先存在（workflow 已先行 kamal accessory boot）。

set -e

[ "$KAMAL_COMMAND" = "rollback" ] && exit 0

CONFIG="${KAMAL_HOOK_CONFIG:-config/deploy.ci.yml}"
REGISTRY=$(grep -E "^  server:" "$CONFIG" | head -1 | awk '{print $2}')
IMAGE="$REGISTRY/codingirlsclub/cgc2046-backend:$KAMAL_VERSION"
SERVER="${KAMAL_HOSTS%%,*}"

# env-file 内容在本地生成（secrets 只进 stdin，不进 argv）
pack_env() {
  for v in DATABASE_URL SECRET_KEY_BASE TOKEN_SIGNING_SECRET \
           SENDCLOUD_API_USER SENDCLOUD_API_KEY SENDCLOUD_FROM \
           SENDCLOUD_FROM_NAME SENDCLOUD_SMS_USER SENDCLOUD_SMS_KEY \
           SENDCLOUD_SMS_TEMPLATE_ID WEB_BASE_URL CORS_ORIGIN \
           OAUTH2_ISSUER_URL OAUTH2_RESOURCE_URL OAUTH2_SIGNING_SECRET; do
    eval "val=\$$v"
    printf '%s=%s\n' "$v" "$val"
  done
  echo "PHX_SERVER=true"
}

# OAUTH2_ISSUER_URL / OAUTH2_RESOURCE_URL 是 deploy.yml env.clear 里的运行时值
# （公开配置，不进 .kamal/secrets），hook 进程 env 里没有——从生成的配置取同值：
# `Cgc2046.Release.seed` 会起完整应用（Application.ensure_all_started），启动自检
# `Cgc2046.Oauth2Server.validate_secrets!/0` 需要三者齐备，缺失即启动失败。
OAUTH2_ISSUER_URL=$(grep -E "^[[:space:]]+OAUTH2_ISSUER_URL:" "$CONFIG" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
OAUTH2_RESOURCE_URL=$(grep -E "^[[:space:]]+OAUTH2_RESOURCE_URL:" "$CONFIG" | head -1 | sed 's/^[^:]*:[[:space:]]*//')
export OAUTH2_ISSUER_URL OAUTH2_RESOURCE_URL

if [ -z "$OAUTH2_ISSUER_URL" ] || [ -z "$OAUTH2_RESOURCE_URL" ]; then
  echo "pre-deploy: OAUTH2_ISSUER_URL / OAUTH2_RESOURCE_URL not found in $CONFIG" >&2
  exit 1
fi

run_on_server() {
  pack_env | ssh deploy@"$SERVER" \
    "docker run --rm --network kamal --env-file /dev/stdin '$IMAGE' $1 $2"
}

echo "pre-deploy: migrations via $IMAGE on $SERVER"
run_on_server eval "Cgc2046.Release.migrate"

echo "pre-deploy: seeds via $IMAGE on $SERVER"
run_on_server eval "Cgc2046.Release.seed"
