# cgc_2046 backend deps 基础镜像（Elixir 依赖预编译层）
#
# 目的：把 mix deps.get + deps.compile 从每次部署的全量重来中摘出。
# tag = sha256(backend/mix.lock + backend/Dockerfile.deps + backend/config/
# config.exs + backend/config/prod.exs) 前 16 位——即**deps 层的全部编译输入**
# （backend/ 与 deploy/ci workflow 的 DEPS_HASH 三处同公式）。后两者不可缺：
# Dockerfile 层调整、或影响依赖编译结果的编译期配置（codepagex `:encodings`
# 编表过滤器，见下方 COPY backend/config/ 注释，#1105）只改 config 不改 lock
# 时，仅 hash lock 会命中旧镜像、prod 拿到过期依赖产物。
# 输入不变则部署直接命中，变更时由 deploy workflow 自动重建推送，无人工维护。
#
# 为什么不走 buildx cache：mode=max 导出 GB 级中间层到 GHA cache 已实证
# 挂起（run 32375926425）；registry cache 每次部署都要付导出成本。
# 本方案把导出频率从「每次部署」降为「每次 mix.lock 变更」。
#
# 构建上下文必须是 repo 根目录（COPY backend/…）：
#   docker build -f backend/Dockerfile.deps -t <registry>/codingirlsclub/cgc2046-backend-deps:<lock-hash> .
#
# 版本与主 Dockerfile / ci.yml 完全对齐：Elixir 1.20 / OTP 29
# MIX_ENV=prod：产物落 _build/prod/，主镜像 compile 直接命中——缺这行时
# deps.compile 落 _build/dev/，主镜像每部署全量重编（016 审计修复）
FROM hexpm/elixir:1.20.0-erlang-29.0-debian-bookworm-20260610-slim
WORKDIR /app
ENV MIX_ENV=prod
RUN apt-get update -y && apt-get install -y --no-install-recommends git ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY backend/mix.exs backend/mix.lock ./
# codepagex 的 :encodings 是**编译期**配置（Application.compile_env，#1105）：
# deps 编译层必须读到 backend/config/，否则按默认过滤器（ascii+iso8859）编译，
# prod 运行时 CP936 缺失、GBK 账单转码崩 UndefinedFunctionError。
COPY backend/config/ config/
RUN mix local.hex --force && mix local.rebar --force \
    && mix deps.get --only prod && mix deps.compile
