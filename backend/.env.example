# cgc_2046 backend 环境变量样例
# 复制为 .env 并填真实值（.env 已 gitignore；direnv 经 .envrc 自动加载）
# 生产注入契约见 docs/运维/邮件与CD环境注入.md（GitHub Secrets 同名注入）
#
# 与 GitHub Environments → production 的对应关系：
#   - 下述变量在 GitHub 侧同名创建；含密钥的进 Secrets，非敏感可变值进 Variables
#   - 本文件即 production environment 的变量清单事实源，增删变量先改这里
#   - 标注（必填）的变量：prod 缺失 = 容器启动直接崩溃，一个都不能漏
#   - 标注（可选）的变量：缺失时对应功能门禁降级（boot 不崩），随功能启用补齐

# ── 核心部署（Phoenix 必需）────────────────────────────────
# PHX_SERVER=true 使 release 启动 web server（容器内必须）
PHX_SERVER=
# 可选：DNS 集群节点发现查询串（单机部署不需要,留空）
DNS_CLUSTER_QUERY=
# 容器内监听端口（kamal-proxy 转发的目标端口）
PORT=4000
# 对外域名（Endpoint url host；用于生成链接）
PHX_HOST=
# （必填）Postgres 连接串；自托管容器 PG 的 host 为 compose 服务名
# 例：ecto://cgc_2046:<密码>@postgres:5432/cgc_2046_prod
# ⚠ 密码必须与服务器上 PG 容器的 POSTGRES_PASSWORD 逐字一致
DATABASE_URL=
# （必填）Phoenix cookie/session 签名密钥，生成：mix phx.gen.secret
SECRET_KEY_BASE=
# （必填）JWT 签名密钥（ash_authentication），生成：mix phx.gen.secret
TOKEN_SIGNING_SECRET=
# Ecto 连接池大小（默认 10）
POOL_SIZE=
# （必填）web 前端正式域名（密码重置链接的 base），生产强制 https://
WEB_BASE_URL=
# （必填）CORS 允许来源，逗号分隔，生产填 web 前端域名
CORS_ORIGIN=

# ── 小程序平台凭证（可选：缺某平台 → 该平台功能门禁降级，boot 不崩）──
# 缺凭证平台的小程序登录/通知/码生成返回 platform_not_configured；
# web 先行部署时可全部留空，小程序上架时补齐即热启用（重启生效）
# wechat：微信公众平台 mp.weixin.qq.com → 开发 → 开发管理 → 开发设置
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# tt（抖音）：抖音开放平台 developer.open-douyin.com → 小程序 → 开发配置
DOUYIN_MP_APPID=
DOUYIN_MP_SECRET=
# xhs（小红书）：小红书开放平台后台 → 开发设置
XHS_MP_APPID=
XHS_MP_SECRET=
# xhs 平台配置的两个小程序页面路径（以后台登记为准）
XHS_MP_QRCODE_PATH=
XHS_MP_NOTIFICATION_PATH=

# ── 小程序订阅消息模板 ID（可选：缺模板 → 对应通知门禁降级）──
# wechat：公众平台 → 功能 → 订阅通知 → 我的模板，复制模板 ID
WECHAT_MP_TEMPLATE_APPROVAL_RESULT=
WECHAT_MP_TEMPLATE_APPROVAL_REMINDER=
WECHAT_MP_TEMPLATE_ENROLLMENT_SUBMITTED=
WECHAT_MP_TEMPLATE_ENROLLMENT_COMPLETED=
WECHAT_MP_TEMPLATE_SPEAKER_ACCEPTED=
WECHAT_MP_TEMPLATE_SPEAKER_COMPLETED=
WECHAT_MP_TEMPLATE_LEARNING_STAGNATION=
WECHAT_MP_TEMPLATE_PAYMENT_SUCCEEDED=
WECHAT_MP_TEMPLATE_REFUND_SUCCEEDED=
WECHAT_MP_TEMPLATE_REFUND_FAILED=
# tt：抖音开放平台 → 小程序 → 订阅消息 → 模板管理
DOUYIN_MP_TEMPLATE_ENROLLMENT_SUBMITTED=
DOUYIN_MP_TEMPLATE_ENROLLMENT_COMPLETED=
DOUYIN_MP_TEMPLATE_SPEAKER_ACCEPTED=
DOUYIN_MP_TEMPLATE_SPEAKER_COMPLETED=
DOUYIN_MP_TEMPLATE_LEARNING_STAGNATION=
DOUYIN_MP_TEMPLATE_PAYMENT_SUCCEEDED=
DOUYIN_MP_TEMPLATE_REFUND_SUCCEEDED=
DOUYIN_MP_TEMPLATE_REFUND_FAILED=
# xhs：小红书开放平台 → 消息 → 模板管理
XHS_MP_TEMPLATE_APPROVAL_RESULT=
XHS_MP_TEMPLATE_APPROVAL_REMINDER=
XHS_MP_TEMPLATE_ENROLLMENT_SUBMITTED=
XHS_MP_TEMPLATE_ENROLLMENT_COMPLETED=
XHS_MP_TEMPLATE_SPEAKER_ACCEPTED=
XHS_MP_TEMPLATE_SPEAKER_COMPLETED=
XHS_MP_TEMPLATE_LEARNING_STAGNATION=
XHS_MP_TEMPLATE_PAYMENT_SUCCEEDED=
XHS_MP_TEMPLATE_REFUND_SUCCEEDED=
XHS_MP_TEMPLATE_REFUND_FAILED=

# ── 支付宝（v3 API，公钥模式；可选）────────────────────────
# open.alipay.com → 控制台 → 我的应用：
#   ALIPAY_APP_ID        = 应用详情页的 APPID
#   ALIPAY_PRIVATE_KEY   = 「接口加签方式(公钥模式)」用密钥工具生成的应用私钥
#   ALIPAY_PUBLIC_KEY    = 上传应用公钥后,加签配置页展示的「支付宝公钥」
# 键值格式：三种形态任选（代码 decode_pem 自适应）
#   A. 裸 base64 单行（推荐，无歧义）——去掉 PEM 头尾与换行
#   B. PEM 全文——含 -----BEGIN/END----- 头尾（多行原样）
#   C. 平台网页复制的一行 base64（即形态 A）
# 注意：ALIPAY_PUBLIC_KEY 是「支付宝公钥」（验签回调用），
#       不是你自己生成的应用公钥；私钥才是你的「应用私钥」
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱开关（沙箱网关不支持 v3，已探明弃用；生产保持空）
ALIPAY_SANDBOX=

# ── 微信支付（APIv3，商户级；可选）─────────────────────────
# 商户平台 pay.weixin.qq.com：
#   WECHAT_PAY_MCH_ID               = 账户中心概览页「商户号」
#   WECHAT_PAY_APPID                = 产品中心 → AppID 账号管理（绑定的小程序）
#   WECHAT_PAY_API_V3_KEY           = 账户中心 → API 安全 → 「APIv3 密钥」
#                                      （自行设置并牢记的 32 位字符串）
#   WECHAT_PAY_API_V2_KEY           = 同页「APIv2 密钥」（SDK 构建客户端必需）
#   WECHAT_PAY_CLIENT_SERIAL_NO     = 「申请 API 证书」通过后,证书压缩包内
#                                      serial_no.txt 的 40 位十六进制序列号
#   WECHAT_PAY_CLIENT_PRIVATE_KEY   = 同压缩包内 apiclient_key.pem 全文
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APPID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_API_V2_KEY=
WECHAT_PAY_CLIENT_SERIAL_NO=
# apiclient_key.pem 全文（必须 PEM 格式——SDK pem_decode 直吃，裸 base64 会崩。
# 单行写法:WECHAT_PAY_CLIENT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...
# 直接换行粘贴亦可）
WECHAT_PAY_CLIENT_PRIVATE_KEY=

# ── 回调与跳转（本地联调=隧道域名；生产=正式域名；可选）─────
# 支付平台服务器回调 backend 的公网基地址（backend 域名,非 web 前端）
PAYMENTS_WEBHOOK_BASE_URL=
ALIPAY_RETURN_URL=

# ── 邮件 SendCloud（plan 022，生产必填·硬门禁）──────────
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
SENDCLOUD_FROM_NAME=

# ── SendCloud 短信验证码（plan 002，生产必填·硬门禁）────
# 注意：SMS_USER/SMS_KEY 与上面邮件的 API_USER/API_KEY 是同控制台下
# 不同凭证对——在「短信语音 → 发送设置 → 发送授权」创建；
# 模板需先在控制台提交审核（含签名），过审后填模板 ID
SENDCLOUD_SMS_USER=
SENDCLOUD_SMS_KEY=
SENDCLOUD_SMS_TEMPLATE_ID=

# ── 微信开放平台网站应用（扫码登录，plan 002；可选）────────
# open.weixin.qq.com 创建「网站应用」过审后获取；授权回调域需登记
# 本地联调扫码：web_base_url 需指向隧道域名（同支付回调模式），
# 否则手机微信扫完跳 localhost 打不开
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
