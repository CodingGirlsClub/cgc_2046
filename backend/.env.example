# cgc_2046 backend 环境变量样例
# 复制为 .env 并填真实值（.env 已 gitignore；direnv 经 .envrc 自动加载）
# 生产注入契约见 docs/运维/邮件与CD环境注入.md（GitHub Secrets 同名注入）

# ── 支付宝（v3 API，公钥模式）──────────────────────────────
# 键值格式：三种形态任选（代码 decode_pem 自适应）
#   A. 裸 base64 单行（推荐，无歧义）——去掉 PEM 头尾与换行
#   B. PEM 全文——含 -----BEGIN/END----- 头尾（多行原样）
#   C. 平台网页复制的一行 base64（即形态 A）
# 注意：ALIPAY_PUBLIC_KEY = 开放平台「支付宝公钥」段（验签回调用），
#       不是你自己生成的应用公钥；私钥才是你的「应用私钥」
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱开关（沙箱网关不支持 v3，已探明弃用；生产保持空）
ALIPAY_SANDBOX=

# ── 微信支付（APIv3，商户级）──────────────────────────────
# 商户平台 pay.weixin.qq.com → 账户中心 / API 安全
WECHAT_PAY_MCH_ID=
# 小程序 AppID（需在商户平台绑定 JSAPI 权限）
WECHAT_PAY_APPID=
# apiclient_key.pem 全文（必须 PEM 格式——SDK pem_decode 直吃,裸 base64 会崩。
# 单行写法:WECHAT_PAY_CLIENT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...(直接换行粘贴亦可)
# ）
WECHAT_PAY_CLIENT_PRIVATE_KEY=
# API 证书序列号（40 位十六进制）
WECHAT_PAY_CLIENT_SERIAL_NO=
# apiclient_key.pem 全文（多行 PEM 直接粘贴）
WECHAT_PAY_CLIENT_PRIVATE_KEY=

# ── 回调与跳转（本地联调=隧道域名；生产=正式域名）──────────
PAYMENTS_WEBHOOK_BASE_URL=
ALIPAY_RETURN_URL=

# ── 邮件 SendCloud（plan 022，生产必填）────────────────────
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
SENDCLOUD_FROM_NAME=
