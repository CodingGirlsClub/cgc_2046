@startuml container-topology
' ============================================================
' L0 - 容器拓扑图（C4 Container）
' 事实来源：仓库顶层结构（backend/ web/ miniprogram/ openclacky-ext/）、
' backend/config/config.exs（Oban PG-backed + payments 队列与 cron :115-137）、
' backend/lib/cgc_2046_web/router.ex（/api/graphql、/mcp、/ops、dev /dev/mailbox、
' /api/payments/webhooks/:provider :50-60）、backend/lib/cgc_2046/payments/
' （order.ex 7 态 CAS 状态机 + webhook_event.ex R21 幂等 + provider.ex behaviour
' → providers/{wechat_pay,alipay,fake}）、backend/lib/cgc_2046_web/controllers/
' payment_webhook_controller.ex（验签→落库→同事务入队）、web/next.config.ts（rewrite）、
' docs/运维/邮件与CD环境注入.md（SendCloud）、
' backend/lib/cgc_2046/workflows/signal_idempotency.ex（claim 落 Postgres）。
' 说明：Redis 仅为幂等层文档备选承载，config 无 Redix 配置——当前唯一
' 持久层为 Postgres。本图按 codebase 现状绘制（2026-08，develop 7c8cadb）。
' ============================================================
title CGC 平台容器拓扑（C4 Container，L0）

skinparam backgroundColor white
skinparam rectangle {
    BackgroundColor #F0FDE8
    BorderColor #2E7D32
}
skinparam database {
    BackgroundColor #FFF3E0
    BorderColor #E65100
}
skinparam arrow {
    Color #455A64
}

actor "用户\n浏览器" as Browser
actor "微信 / 抖音 /\n小红书客户端" as MP
actor "OpenClacky\n（用户本机 Agent）" as OC

rectangle "用户侧（BYO，非平台交付物）" as USERSIDE #E8F0FE {
    rectangle "openclacky-ext/cgc-2046\n（OpenClacky 扩展）\n· connect API 原子写 ~/.clacky/mcp.json\n· panel / agent / skill / hooks" as EXT
}

rectangle "CGC-2046 平台（仓库交付物）" as PLATFORM #F0FDE8 {

    rectangle "web/\nNext.js 16 + React 19\n+ Apollo Client" as WEB {
        rectangle "/api/graphql rewrite\n→ backend（同源代理）" as REWRITE
    }

    rectangle "miniprogram/\nTaro 4 + React 18\n多端：weapp / tt / xhs" as MINI {
        rectangle "graphql-codegen\n（check:graphql 防漂移）" as CODEGEN
    }

    rectangle "backend/\nPhoenix + Ash 3" as BE {
        rectangle "GraphQL API\nAbsinthe @ /api/graphql\n（+ /api/playground dev）" as GQL
        rectangle "MCP Server\nanubis_mcp streamable HTTP\n@ /mcp（Bearer）" as MCP
        rectangle "AshAdmin @ /ops\n（admin_browser）" as OPS
        rectangle "渠道回调入口\nPaymentWebhookController\nPOST /api/payments/webhooks/:provider\n（无 actor，验签即鉴权）" as WBHK
        rectangle "Workflow 引擎\nJido + run/checkpoint\n+ SignalEmitter/七订阅方\n（Phoenix PubSub 进程内总线）" as ENGINE
        rectangle "Payments 域\nOrder（payments_orders）\n7 态 CAS 状态机 + WebhookEvent\n（回调去重，均不外露）；\nProvider behaviour → adapter\nWechatPay / Alipay / Fake" as PAY
        rectangle "Oban Workers\n（PG-backed，无独立队列服务；\n队列 maintenance / notifications /\npayments）\nsignal_publish / approval_reminder\n/ reconciliation_scan…\n+ payment_expiry / refund /\nsettlement / reconciliation\n（另：event_cancel_refund\n订阅 event.ended 回查 cancelled\n批量退款）" as OBR
        rectangle "Swoosh 邮件\nSendCloud adapter（prod）\nTest adapter + /dev/mailbox\n（test/dev）" as MAIL
    }

    database "PostgreSQL\n业务表（Ash multitenancy）\n+ Oban jobs + signal_idempotency\n+ workflow checkpoints" as PG
}

cloud "SendCloud\napi.sendcloud.net" as SENDCLOUD #FFFDE7

cloud "微信支付 WeChat Pay\napi.mch.weixin.qq.com（v3）" as WECHATPAY #FFFDE7
cloud "支付宝 Alipay\nopenapi.alipay.com" as ALIPAY #FFFDE7

Browser --> WEB : HTTPS（页面）
MP --> MINI : 宿主渲染
WEB --> GQL : GraphQL（cookie JWT\nAshAuthentication）
MINI --> GQL : GraphQL（signInWithPlatform\n+ mini program code）
OC --> EXT : 本机进程内
EXT ..> MCP : 配置 MCP URL + token\n（mcp.json 注入后由\nOpenClacky MCP client 连接）
OC --> MCP : streamable HTTP\nAuthorization: Bearer
GQL --> ENGINE
MCP --> ENGINE
OPS --> PG
ENGINE --> PG
OBR --> PG
ENGINE --> OBR : 入队 / 重投
MAIL --> SENDCLOUD : Req POST\n（prod only）
GQL --> MAIL : 业务邮件触发

GQL --> PAY : 下单/查单/退款/统计\n（payment GraphQL 面）
PAY --> PG
WBHK --> PAY : 验签 → WebhookEvent\n幂等落库（R21）
WBHK --> OBR : 同事务入队落账 job\n（settlement，快速 200）
PAY --> WECHATPAY : 渠道外呼\n下单/查单/退款/对账
PAY --> ALIPAY : 渠道外呼\n下单/查单/退款/对账
WECHATPAY --> WBHK : 支付/退款回调\n（重复投递重试）
ALIPAY --> WBHK : 支付/退款回调\n（重复投递重试）

note right of PG
  唯一持久层。幂等三层之一
  （signal claim）落
  signal_idempotency 表，
  Postgres 唯一索引兜底。
  Redis 仅文档备选，未接线。
end note

note right of WBHK
  全新对外面：无 actor，
  鉴权 = 渠道验签（微信 v3
  签名 / 支付宝 RSA2）；raw
  body 原文经 endpoint
  CachingBodyReader 缓存；
  幂等 = (provider, event_id)
  唯一索引，重复投递按
  成功回执。
end note

note bottom of USERSIDE
  openclacky-ext 属用户侧扩展
  （OpenClacky ≥1.3.7），不是
  平台运行时容器；平台经 MCP
  工具面与其协作（D6 形态 X）。
end note
@enduml
