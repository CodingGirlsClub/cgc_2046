@startuml domain-model-er
' ============================================================
' L1 - 领域模型 ER 图（Domain Model ER）
' 事实来源（代码锚点）：backend/lib/cgc_2046/global_api.ex · api.ex · mcp.ex
'   资源注册清单及各资源模块（漂移复核：DRIFT-EVIDENCE/L1-domain-model.md §1）
' 说明：全局资源（User/Identity/Token/Workspace/WorkspaceApplication/
'   AdminActionLog/Reconciliation.Finding）不按租户隔离；
'   其余实体按租户隔离（tenant_id / partition = Workspace）。
' ============================================================
title CGC 平台领域模型 ER（L1）
skinparam backgroundColor white
skinparam linetype ortho
skinparam Entity {
    BackgroundColor #FFF7E6
    BorderColor #B26A00
}

' ---------- 全局资源 ----------
entity "User" as USER {
    * id : uuid <<PK>>
    --
    email : string
    is_platform_admin : boolean
}
entity "Identity" as IDENTITY {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    provider : string
}
entity "Token" as TOKEN {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
}
entity "Workspace" as WORKSPACE {
    * id : uuid <<PK>>
    --
    slug : string <<UK>>
    name : string
    join_policy : open|request|invite_only
    sponsorship_enabled : boolean
    sponsorship_tiers : json (内嵌档位)
}

' ---------- 身份/租户 ----------
entity "WorkspaceMembership" as WM {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    workspace_id : uuid <<FK>>
}
entity "MembershipRole" as MR {
    * id : uuid <<PK>>
    --
    membership_id : uuid <<FK>>
    role_id : uuid <<FK>>
}
entity "Role" as ROLE {
    * id : uuid <<PK>>
    --
    name : string
}
entity "Profile" as PROFILE {
    * id : uuid <<PK>>
    --
    membership_id : uuid <<FK>>
    avatar / intro / portfolio
}
entity "Invitation" as INVITATION {
    * id : uuid <<PK>>
    --
    token_hash : string
    expires_at : datetime
    inviter_id : uuid <<FK>>
    workspace_id : uuid <<FK>>
    target_email : string
    status : active|used|revoked|expired
}
entity "JoinRequest" as JOINREQUEST {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    workspace_id : uuid <<FK>>
    status : pending|approved|rejected|expired
}

entity "WorkspaceApplication" as WSAPP {
    * id : uuid <<PK>>
    --
    applicant_id : uuid <<FK>>
    name / slug / purpose
    status : pending|approved|rejected|expired
    approved_by / approved_at
    rejected_by / rejected_at / approval_deadline
}
entity "AdminActionLog" as ADMINLOG {
    * id : uuid <<PK>>
    --
    actor_id : uuid  (nil = 系统/CLI)
    action : workspace_create|application_approve|…
    target_type : workspace|workspace_application|user
    target_id : uuid
    result : success|failure
}
entity "PortfolioItem" as PORTFOLIO {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    workspace_id : uuid <<FK>>
    title / description / url
    icon : document|book|guide
}

' ---------- 小程序 ----------
entity "MiniprogramCode" as MPCODE {
    * id : uuid <<PK>>
    --
    invitation_id : uuid <<FK>>
    platform : wechat|tt|xhs
    scene : string <<UK>>
    code : binary
    expires_at : datetime
    UK (invitation_id, platform)
}
entity "NotificationConsent" as MPCONSENT {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    platform : wechat|tt|xhs
    template_key : string
    remaining_uses : integer
    UK (user_id, platform, template_key)
}

' ---------- 引擎 context ----------
entity "WorkflowDefinition" as WFDEF {
    * id : uuid <<PK>>
    --
    name : string
    type : learning|research|speaker_invitation
          |enrollment|sponsorship (预留)
    version : integer
    input_schema : json
    node_def : Runic.Workflow
    status : draft|published|archived
}
entity "WorkflowRun" as WFRUN {
    * id : uuid <<PK>>
    --
    definition_id : uuid <<FK>>
    status : pending|running|waiting|expired
            |succeeded|failed|cancelled
    input_snapshot : json
    facts : json  (教研产出按 step_key 聚合)
    partition_id : uuid  (= workspace_id)
    started_at / finished_at
}
entity "Step" as STEP {
    * id : uuid <<PK>>
    --
    definition_id : uuid <<FK>>
    type : auto|manual|gate|sub_workflow
    title : string
    sub_definition_id : uuid <<FK>>
}
entity "StepRole" as STEPROLE {
    * id : uuid <<PK>>
    --
    step_id : uuid <<FK>>
    role_id : uuid <<FK>>
}
entity "SignalLog" as SIGNALLOG {
    * id : uuid <<PK>>
    --
    run_id : uuid <<FK>>
    signal_type : string
    payload : json
    actor_id : uuid <<FK>>
    received_at : datetime
}

entity "SignalIdempotency" as SIGIDEM {
    * id : uuid <<PK>>
    --
    signal_type : string
    idempotency_key : string
    workspace_id : uuid  (观测可空)
    UK (signal_type, idempotency_key)
}
entity "Reconciliation.Finding" as FINDING {
    * id : uuid <<PK>>
    --
    rule : string  (七规则)
    entity_type / entity_id
    first_seen_at / last_seen_at
    UK (rule, entity_type, entity_id)
}

' ---------- MCP ----------
entity "PendingOperation" as PENDING {
    * id : uuid <<PK>>
    --
    actor_id : uuid <<FK>>
    tool : string
    params : json
    summary : string
    status : pending|confirmed|cancelled
    expires_at : datetime
}
entity "ToolCallLog" as TOOLCALL {
    * id : uuid <<PK>>
    --
    actor_id : uuid <<FK>>
    tool : string
    params / result : json
    pending_operation_id : uuid <<FK>>
    result_status : ok|error|needs_confirmation|forbidden
}

entity "McpToken" as MCPTOKEN {
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    token_hash : string <<UK>>
    name : string
    last_used_at / revoked_at
}

' ---------- 业务 ----------
entity "Event" as EVENT {
    * id : uuid <<PK>>
    --
    title : string
    workflow_run_id : uuid <<FK>>  (教研产物)
    start_at / end_at
    enrollment_policy : open|request|invite_only
    capacity : integer
    registration_deadline : datetime
    status : draft|open|closed|cancelled
    sponsorship_enabled : boolean
    sponsorship_deadline : datetime
    sponsorship_tiers : json (内嵌档位)
}
entity "Course" as COURSE {
    * id : uuid <<PK>>
    --
    title : string
    workflow_run_id : uuid <<FK>>
    enrollment_policy / capacity
    registration_deadline / status
}
entity "Enrollment" as ENROLLMENT {
    * id : uuid <<PK>>
    --
    event_id / course_id : uuid <<FK>> (二选一)
    user_id : uuid <<FK>>
    run_id : uuid <<FK>>
    status : pending|confirmed|rejected|cancelled|expired
    invite_batch_id : uuid <<FK>>
    approved_by / approved_at
    rejection_reason
}
entity "InviteBatch" as INVITEBATCH {
    * id : uuid <<PK>>
    --
    event_id / course_id : uuid <<FK>> (二选一)
    invite_code : string <<UK>>
    quota : integer
    remaining_quota : integer
    expires_at : datetime
    status : active|disabled
    remark : string
}
entity "Sponsorship" as SPONSORSHIP {
    * id : uuid <<PK>>
    --
    level : event|workspace
    event_id / workspace_id : uuid <<FK>>
    sponsor_user_id : uuid <<FK>>
    tier_id : uuid  (内嵌档位 id)
    tier_name : string
    status : pending|active|rejected|ended|expired
    amount / company_name / contact_email / contact_phone
    approved_by / approved_at / rejection_reason
    workflow_run_id : uuid <<FK>>
}
entity "SponsorshipDelivery" as DELIVERY {
    * id : uuid <<PK>>
    --
    sponsorship_id : uuid <<FK>>
    benefit : string
    due_date / fulfilled_at
    proof_note : string
    exclusive : boolean
}
entity "SpeakerInvitation" as SPEAKERINV {
    * id : uuid <<PK>>
    --
    event_id : uuid <<FK>>
    speaker_user_id : uuid <<FK>> (接受后绑定)
    speaker_name / speaker_email
    token_hash : string <<UK>> (一次性)
    invited_by : uuid <<FK>>
    status : invited|accepted|declined|completed
    accepted_by / accepted_at / declined_at / completed_at
    expires_at : datetime
    workflow_run_id : uuid <<FK>>
}

' ---------- 关系 ----------
USER ||--o{ IDENTITY : 认证身份
USER ||--o{ TOKEN : 登录令牌
USER ||--o{ WM : 加入
USER ||--o{ JOINREQUEST : 提交申请
USER ||--o{ ENROLLMENT : 报名
USER ||--o{ SPEAKERINV : 受邀演讲
USER ||--o{ SPONSORSHIP : 赞助
USER ||--o{ WSAPP : 申请建台
USER ||--o{ PORTFOLIO : 作品集
USER ||--o{ MCPTOKEN : MCP 连接 token
USER ||--o{ MPCONSENT : 订阅授权
WORKSPACE ||--o{ WM : 包含成员
WORKSPACE ||--o{ ROLE : 定义角色
WORKSPACE ||--o{ WFDEF : 承载流程
WORKSPACE ||--o{ INVITATION : 发出邀请
INVITATION ||--o{ MPCODE : 小程序码
WORKSPACE ||--o{ JOINREQUEST : 收到申请
WORKSPACE ||--o{ PENDING : 确认流
WORKSPACE ||--o{ TOOLCALL : 工具调用审计
WORKSPACE ||--o{ EVENT : 举办活动
WORKSPACE ||--o{ COURSE : 开设课程
WORKSPACE ||--o{ SPONSORSHIP : 赞助关系
WM ||--o{ MR : 拥有角色
ROLE ||--o{ MR : 被授予
WM ||--o| PROFILE : 公开资料
WFDEF ||--o{ STEP : 分解节点
WFDEF ||--o{ WFRUN : 实例化
WFRUN ||--o{ SIGNALLOG : 信号日志
STEP ||--o{ STEPROLE : 执行角色
ROLE ||--o{ STEPROLE : 授权执行
TOOLCALL }o--o| PENDING : 确认关联
WFRUN ||--o{ ENROLLMENT : 创建报名
EVENT ||--o{ ENROLLMENT : 报名
COURSE ||--o{ ENROLLMENT : 报名
EVENT ||--o{ SPONSORSHIP : Event 级赞助
SPONSORSHIP ||--o{ DELIVERY : 履约账本
EVENT ||--o{ SPEAKERINV : 邀请演讲者
EVENT ||--o{ INVITEBATCH : 邀请批次
COURSE ||--o{ INVITEBATCH : 邀请批次
INVITEBATCH ||--o{ ENROLLMENT : 批次扣减

note bottom of WFRUN
  WORKFLOW_RUN.partition_id = workspace_id
  （每个 Workspace = 一个 Jido partition，D-A5）
  唯一索引要点：
  - Enrollment: (event_id,user_id) / (course_id,user_id)
    部分唯一（status ∈ pending/confirmed）
  - Sponsorship: (level, target_id, sponsor_user_id) 部分唯一
  - SpeakerInvitation.token_hash 一次性
  - SignalIdempotency: (signal_type, idempotency_key)
  - 赞助档位 = Event/Workspace.sponsorship_tiers 内嵌 json，
    Sponsorship.tier_id 指向内嵌档位 id（无独立表）
end note

@enduml
