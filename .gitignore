# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.local

# Logs
*.log

# Claude Code (project-local settings, not shared)
.claude/settings.local.json

# Node dependencies（根目录不应有 node_modules；web/ 各自忽略）
node_modules/
openclacky-ext/dist/

# pnpm store（web 工作区的全局硬链接缓存，不入库）
.pnpm-store/
.worktrees

# direnv 机制文件入库（.env 真实值仍忽略）；用户全局 ignore 常忽略 .envrc，此处显式豁免
!backend/.envrc
.ml-cache/
.mainline/local.toml
