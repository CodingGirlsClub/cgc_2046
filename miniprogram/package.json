{
  "name": "cgc-miniprogram",
  "version": "0.2.7",
  "private": true,
  "description": "CGC 微信小程序全量端（Taro 4 + React 18 + TypeScript）",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:tt": "taro build --type tt",
    "build:xhs": "taro build --type xhs",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:tt": "taro build --type tt --watch",
    "dev:xhs": "taro build --type xhs --watch",
    "codegen": "graphql-codegen-cjs --config codegen.yml",
    "check:graphql": "node scripts/check-graphql.mjs",
    "typecheck": "tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:diversion": "node scripts/check-no-diversion.mjs",
    "check:xhs-patch": "node scripts/check-xhs-share-pairing.mjs",
    "check:release-endpoint": "node scripts/check-release-endpoint.mjs",
    "check:release-schema": "node scripts/check-release-schema.mjs",
    "test:unit": "node --experimental-strip-types --test 'tests/**/*.test.ts' 'tests/**/*.test.mjs' && vitest run",
    "audit:prod": "node scripts/audit-if-deps-changed.mjs -- pnpm audit --prod --audit-level high",
    "check:ci": "pnpm audit:prod && pnpm codegen && git diff --exit-code -- src/api/generated && pnpm typecheck && pnpm check:licenses && pnpm test:unit && pnpm build:weapp && node scripts/check-bundle-size.mjs && pnpm build:tt && pnpm build:xhs && pnpm check:xhs-patch && pnpm check:diversion && pnpm build:weapp:mock && node scripts/check-anchors.mjs && node scripts/check-e2e-docs.mjs",
    "build:weapp:mock": "CGC_E2E_MOCK=true pnpm build:weapp",
    "build:all": "pnpm build:weapp && pnpm build:tt && pnpm build:xhs",
    "e2e": "node e2e/run.mjs",
    "e2e:order-pay-consent": "bash e2e/order-pay-deposit-consent.e2e.sh",
    "e2e:initiative": "bash e2e/initiative-journey.e2e.sh",
    "e2e:flashback": "bash e2e/flashback-journey.e2e.sh"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "graphql": "16.11.0",
    "graphql-request": "7.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.29.7",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.5",
    "@prefresh/babel-plugin": "^0.5.3",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/plugin-platform-xhs": "1.2.2",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.2.1",
    "dotenv": "16.6.1",
    "miniprogram-automator": "0.12.1",
    "postcss": "^8.4.47",
    "react-refresh": "^0.14.2",
    "spdx-expression-parse": "5.0.0",
    "typescript": "^5.8.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "webpack": "^5.91.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "decode-uri-component@<=0.5.0": "0.5.1",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.12",
      "webpack-dev-middleware@>=5.0.0 <7.4.6": "7.4.6",
      "svgo@>=3.0.0 <3.3.5": "3.3.5",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimist@<0.2.4": "1.2.8",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "postcss@7": "8.5.26",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.7",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "shell-quote@>=1.8.4 <1.11.0": "1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "compression@<1.8.2": "1.8.2",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "node-forge@<1.4.3": "1.4.3",
      "launch-editor@<=2.14.1": "2.14.2",
      "body-parser@<1.20.9": "1.20.9",
      "vm2@<3.12.2": "3.12.2",
      "swiper@<12.1.2": "12.1.2",
      "qs@<6.16.2": "6.16.2",
      "@fastify/busboy@<3.2.2": "3.2.2",
      "@graphql-tools/executor-legacy-ws@<1.1.36": "1.1.36",
      "@graphql-tools/utils@<12.0.2": "12.0.2",
      "axios@<1.20.0": "1.20.0",
      "adm-zip@<0.6.1": "0.6.1",
      "serialize-javascript@<7.1.3": "7.1.3",
      "vite@<8.2.4": "8.2.4",
      "jpeg-js@<0.4.4": "0.4.4",
      "http-cache-semantics@<4.1.1": "4.3.0",
      "joi@<17.13.9": "17.13.9"
    }
  }
}
