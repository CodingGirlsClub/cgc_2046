{
  "name": "cgc-miniprogram",
  "version": "0.0.1",
  "private": true,
  "description": "CGC 微信小程序全量端（Taro 4 + React 18 + TypeScript）",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:tt": "taro build --type tt",
    "build:xhs": "taro build --type xhs",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:tt": "taro build --type tt --watch",
    "dev:xhs": "taro build --type xhs --watch",
    "codegen": "graphql-codegen-cjs --config codegen.yml",
    "check:graphql": "node scripts/check-graphql.mjs",
    "typecheck": "tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:diversion": "node scripts/check-no-diversion.mjs",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/payment-domain.test.ts tests/error-copy.test.ts tests/diversion-policy.test.ts tests/license-policy.test.mjs tests/share-route.test.ts && vitest run tests/api-client.test.ts tests/account-state.test.ts tests/real-auth.test.ts tests/error-codes.contract.test.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check:ci": "pnpm audit:prod && pnpm codegen && git diff --exit-code -- src/api/generated && pnpm typecheck && pnpm check:licenses && pnpm test:unit && pnpm build:weapp && pnpm build:tt && pnpm build:xhs && pnpm check:diversion && pnpm build:weapp:mock",
    "build:weapp:mock": "CGC_E2E_MOCK=true pnpm build:weapp",
    "build:all": "pnpm build:weapp && pnpm build:tt && pnpm build:xhs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "graphql": "16.11.0",
    "graphql-request": "7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.29.7",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.5",
    "@prefresh/babel-plugin": "^0.5.3",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/plugin-platform-xhs": "1.2.2",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "26.2.0",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.2.1",
    "miniprogram-automator": "0.12.1",
    "postcss": "^8.4.47",
    "react-refresh": "^0.14.2",
    "spdx-expression-parse": "5.0.0",
    "typescript": "^5.8.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webpack": "^5.91.0"
  }
}
