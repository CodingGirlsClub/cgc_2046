# 小程序生产构建 env 模板（2026-08-26 微信模板申请落定后启用）。
# 用法：cp .env.prod.example .env.prod && 填值；构建时 Taro 自动读取（config/index.ts
# 经 dotenv 读取，见该文件）。生产构建前必须设置 CGC_GRAPHQL_ENDPOINT。
#
# 微信订阅消息模板 ID 与后端 GitHub production secrets 同源
# （WECHAT_MP_TEMPLATE_*，2026-08-26 由公众平台申请）：
#   参与活动提醒（审批结果）/ 待处理申请提醒（审批提醒）/ 活动开始提醒（活动提醒）
CGC_GRAPHQL_ENDPOINT=https://api.codingirlsclub.com/api/graphql

CGC_WECHAT_TEMPLATE_APPROVAL_RESULT=Ft-Pv4a4orb1BiAewj6xxuKTrE0P0Pe13TCLQqHUrBU
CGC_WECHAT_TEMPLATE_APPROVAL_REMINDER=APTdJ-qF0SATcHn3U2-KbYJe5xQbDY-UrKlDDtZLA8k
CGC_WECHAT_TEMPLATE_EVENT_REMINDER=8DhD7tmhePubeeqaNKFYnVfC1L76zg1TF6RvpNyp32A

# 抖音裁剪端（模板未申请，占位空值——tt 构建不注入则订阅弹层自动跳过）
CGC_DOUYIN_TEMPLATE_APPROVAL_RESULT=
CGC_DOUYIN_TEMPLATE_EVENT_REMINDER=

# 仅供自动化构建使用，生产环境不得开启。
CGC_E2E_MOCK=false
