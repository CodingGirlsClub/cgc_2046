# 小程序生产构建 env 模板。
# 用法：cp .env.prod.example .env.prod && 填值；构建时 Taro 自动读取（config/index.ts
# 经 dotenv 读取 + config/env.ts 装载，见该文件）。生产构建前必须设置
# CGC_GRAPHQL_ENDPOINT **以及全部 19 个微信模板 ID**。
#
# 微信订阅消息模板 ID 与后端 GitHub production secrets 同源
# （WECHAT_MP_TEMPLATE_*，2026-08-26 / 2026-09-16 由公众平台分两批申请）。
# **本文件不得写入真实模板 ID**（#635 红线）：2026-08-26 曾把 3 个真实 ID 提交
# 进仓，造成「example 与 secrets 两份真源」——改一处漏一处正是 #606 的根因类别。
# 守卫测试 tests/subscription-build.test.mjs 会拒绝任何 40+ 字符的 ID 字面量。
#
# ⚠ 小程序**没有** CI 部署 job（.github/workflows/deploy.yml 仅有 backend/web）：
#   生产产物由人工在本机构建，构建前必须导出下面 18 个变量，否则用户点了授权也
#   拿不到模板 ID（请求期 fail-closed 会给出可读错误，不会静默）。
#   逐条清单与验证步骤见 docs/运维/小程序订阅消息构建与真机验证.md。
CGC_GRAPHQL_ENDPOINT=https://api.codingirlsclub.com/api/graphql

# 微信：19 个场景（键名 = CGC_WECHAT_TEMPLATE_ + 场景键 SCREAMING_SNAKE，
# 与 config/index.ts 的 WECHAT_SCENARIOS 列表双射）
CGC_WECHAT_TEMPLATE_APPROVAL_RESULT=
CGC_WECHAT_TEMPLATE_APPROVAL_REMINDER=
CGC_WECHAT_TEMPLATE_EVENT_REMINDER=
# #664 报名成功通知（open 免费场/课程与提交同事务落 confirmed，授权必须在提交前）
CGC_WECHAT_TEMPLATE_ENROLLMENT_COMPLETED=
# #546 核销码通知（报名落 confirmed 时下发 6 位核销码）
CGC_WECHAT_TEMPLATE_ENROLLMENT_CHECK_IN_CODE=
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_CONFIRMED=
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_UNDERFILLED=
# #585 管理侧开班结果（Owner/Admin 收件；模板申请为部署前置）
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_MANAGER=
CGC_WECHAT_TEMPLATE_EVENT_SCHEDULE_CHANGED=
CGC_WECHAT_TEMPLATE_EVENT_MODERATOR_ASSIGNED=
CGC_WECHAT_TEMPLATE_SPEAKER_ACCEPTED=
CGC_WECHAT_TEMPLATE_SPEAKER_COMPLETED=
CGC_WECHAT_TEMPLATE_LEARNING_STAGNATION=
# #683 支付/退款/管理者六键（资金类通知的授权入口；模板 ID 由公众平台申请，
# 后端 production secrets 已有同名 WECHAT_MP_TEMPLATE_* 注入）
CGC_WECHAT_TEMPLATE_PAYMENT_SUCCEEDED=
CGC_WECHAT_TEMPLATE_PAYMENT_EXPIRED=
CGC_WECHAT_TEMPLATE_REFUND_SUCCEEDED=
CGC_WECHAT_TEMPLATE_REFUND_FAILED=
CGC_WECHAT_TEMPLATE_ENROLLMENT_SUBMITTED=
CGC_WECHAT_TEMPLATE_PAYMENT_RECEIVED=

# 抖音裁剪端（模板未申请，占位空值——tt 构建不注入则订阅弹层自动跳过）
CGC_DOUYIN_TEMPLATE_APPROVAL_RESULT=
CGC_DOUYIN_TEMPLATE_EVENT_REMINDER=

# 仅供自动化构建使用，生产环境不得开启。
CGC_E2E_MOCK=false
