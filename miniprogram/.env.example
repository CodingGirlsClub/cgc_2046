# 开发环境默认使用 http://localhost:4001/api/graphql；发布构建必须设为真实 HTTPS 合法域名。
CGC_GRAPHQL_ENDPOINT=

# 微信公众平台申请的十九个一次性订阅消息模板 ID。
# 键名 = CGC_WECHAT_TEMPLATE_ + 场景键 SCREAMING_SNAKE，与 config/index.ts 的
# WECHAT_SCENARIOS 列表双射（守卫测试 tests/subscription-build.test.mjs）。
# 缺配为空 → 该场景在请求期被 fail-closed 剔除（不是静默发错模板）。
CGC_WECHAT_TEMPLATE_APPROVAL_RESULT=
CGC_WECHAT_TEMPLATE_APPROVAL_REMINDER=
CGC_WECHAT_TEMPLATE_EVENT_REMINDER=
CGC_WECHAT_TEMPLATE_ENROLLMENT_COMPLETED=
CGC_WECHAT_TEMPLATE_ENROLLMENT_CHECK_IN_CODE=
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_CONFIRMED=
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_UNDERFILLED=
# #585 管理侧开班结果（Owner/Admin 收件，单键双文案）
CGC_WECHAT_TEMPLATE_EVENT_QUALIFICATION_MANAGER=
CGC_WECHAT_TEMPLATE_EVENT_SCHEDULE_CHANGED=
CGC_WECHAT_TEMPLATE_EVENT_MODERATOR_ASSIGNED=
CGC_WECHAT_TEMPLATE_SPEAKER_ACCEPTED=
CGC_WECHAT_TEMPLATE_SPEAKER_COMPLETED=
CGC_WECHAT_TEMPLATE_LEARNING_STAGNATION=
# #683 支付/退款/管理者六键（资金类通知的授权入口）
CGC_WECHAT_TEMPLATE_PAYMENT_SUCCEEDED=
CGC_WECHAT_TEMPLATE_PAYMENT_EXPIRED=
CGC_WECHAT_TEMPLATE_REFUND_SUCCEEDED=
CGC_WECHAT_TEMPLATE_REFUND_FAILED=
CGC_WECHAT_TEMPLATE_ENROLLMENT_SUBMITTED=
CGC_WECHAT_TEMPLATE_PAYMENT_RECEIVED=

# 抖音开放平台申请的订阅消息模板 ID（裁剪端仅学习者两场景；小红书走服务通知无需模板 ID）。
CGC_DOUYIN_TEMPLATE_APPROVAL_RESULT=
CGC_DOUYIN_TEMPLATE_EVENT_REMINDER=

# 仅供自动化构建使用，生产环境不得开启。
CGC_E2E_MOCK=false
