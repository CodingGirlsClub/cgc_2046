# 开发环境默认使用 http://localhost:4001/api/graphql；发布构建必须设为真实 HTTPS 合法域名。
CGC_GRAPHQL_ENDPOINT=

# 微信公众平台申请的三个一次性订阅消息模板 ID。
CGC_WECHAT_TEMPLATE_APPROVAL_RESULT=
CGC_WECHAT_TEMPLATE_APPROVAL_REMINDER=
CGC_WECHAT_TEMPLATE_EVENT_REMINDER=

# 抖音开放平台申请的订阅消息模板 ID（裁剪端仅学习者两场景；小红书走服务通知无需模板 ID）。
CGC_DOUYIN_TEMPLATE_APPROVAL_RESULT=
CGC_DOUYIN_TEMPLATE_EVENT_REMINDER=

# 仅供自动化构建使用，生产环境不得开启。
CGC_E2E_MOCK=false
